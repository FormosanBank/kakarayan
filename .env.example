# Local API. The database and manifest must describe the same prepared release.
KAKARAYAN_DB_PATH=/absolute/path/to/formosanbank.sqlite
KAKARAYAN_RELEASE_MANIFEST_PATH=/absolute/path/to/release-manifest.json
KAKARAYAN_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Vite embeds this public URL in the static site at build time.
VITE_KAKARAYAN_API_URL=http://127.0.0.1:8000
