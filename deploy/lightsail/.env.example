# Replace this with a hostname that resolves to the instance's attached static IP.
# For a proof of concept, 203-0-113-10.sslip.io resolves to 203.0.113.10.
KAKARAYAN_HOSTNAME=203-0-113-10.sslip.io

# Browser origins only. Paths such as /kakarayan are not part of an origin.
KAKARAYAN_CORS_ORIGINS=https://formosanbank.github.io,http://localhost:5173,http://127.0.0.1:5173

# SQLite progress callbacks per request. The default permits long analytical queries.
KAKARAYAN_QUERY_STEP_LIMIT=2000000
