# Replace this with a hostname that resolves to the instance's attached static IP.
# For a proof of concept, 203-0-113-10.sslip.io resolves to 203.0.113.10.
KAKARAYAN_HOSTNAME=203-0-113-10.sslip.io

# Browser origins only. Paths such as /kakarayan are not part of an origin.
KAKARAYAN_CORS_ORIGINS=https://formosanbank.github.io,http://localhost:5173,http://127.0.0.1:5173

# Container budgets for the production 4 GiB host. This leaves memory for Ubuntu,
# Docker, filesystem cache, and deployment work.
KAKARAYAN_API_MEMORY_LIMIT=3g
KAKARAYAN_CADDY_MEMORY_LIMIT=128m

# SQLite progress callbacks per request. The default permits long analytical queries.
KAKARAYAN_QUERY_STEP_LIMIT=2000000

# Public API protection. Rates are sustained per client IP; bursts are immediate tokens.
KAKARAYAN_REQUESTS_PER_MINUTE=60
KAKARAYAN_REQUEST_BURST=20
KAKARAYAN_EXPORTS_PER_MINUTE=5
KAKARAYAN_EXPORT_BURST=5

# Keep the two-vCPU host responsive under analytical reads. More RAM does not add
# query workers; excess work fails fast instead of starving the whole service.
KAKARAYAN_QUERY_CONCURRENCY=2
KAKARAYAN_ANALYTICAL_QUERY_CONCURRENCY=1
KAKARAYAN_QUERY_QUEUE_WAIT_SECONDS=1

# Reuse two read-only connections. Each keeps a 128 MiB SQLite page cache and may
# memory-map up to 2 GiB of the shared immutable database on the 4 GiB host.
KAKARAYAN_SQLITE_CACHE_MIB=128
KAKARAYAN_SQLITE_MMAP_MIB=2048

# Hard deadlines stop abandoned or unexpectedly expensive SQLite work.
KAKARAYAN_QUERY_TIMEOUT_SECONDS=10
KAKARAYAN_DATASET_PREVIEW_TIMEOUT_SECONDS=15
KAKARAYAN_DATASET_EXPORT_TIMEOUT_SECONDS=120
