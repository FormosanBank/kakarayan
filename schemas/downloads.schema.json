{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formosanbank.github.io/kakarayan/schemas/downloads.schema.json",
  "title": "Kakarayan prepared downloads",
  "type": "object",
  "required": ["schema_version", "release_id", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "release_id": {"type": "string", "pattern": "^fb-[0-9]{8}-[0-9a-f]{7,12}$"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "media_type",
          "bytes",
          "sha256",
          "scope",
          "rights_ids",
          "publishable",
          "blocked_reasons",
          "download_url",
          "format",
          "language_ids",
          "corpus_ids",
          "tiers"
        ],
        "properties": {
          "path": {"type": "string", "pattern": "^[^/]"},
          "media_type": {"type": "string"},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "scope": {"type": "string"},
          "rights_ids": {"type": "array", "items": {"type": "string"}},
          "publishable": {"type": "boolean"},
          "blocked_reasons": {"type": "array", "items": {"type": "string"}},
          "download_url": {"type": "string", "format": "uri"},
          "format": {"type": "string"},
          "language_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "corpus_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "tiers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "compression": {"enum": ["gzip"]},
          "content_media_type": {"type": "string"},
          "content_bytes": {"type": "integer", "minimum": 1},
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "dependentRequired": {
          "compression": ["content_media_type", "content_bytes", "content_sha256"],
          "content_media_type": ["compression", "content_bytes", "content_sha256"],
          "content_bytes": ["compression", "content_media_type", "content_sha256"],
          "content_sha256": ["compression", "content_media_type", "content_bytes"]
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
