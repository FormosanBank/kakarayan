{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formosanbank.github.io/kakarayan/schemas/export-recipe.schema.json",
  "title": "Kakarayan export recipe",
  "type": "object",
  "required": [
    "schema_version",
    "release_id",
    "selection",
    "fields",
    "format",
    "spreadsheet_safe"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "release_id": {"type": "string", "pattern": "^fb-[0-9]{8}-[0-9a-f]{7,12}$"},
    "selection": {
      "type": "object",
      "required": [
        "query",
        "match",
        "language_ids",
        "corpus_ids",
        "record_ids",
        "max_rows",
        "query_field",
        "translation_language",
        "dialects",
        "requirements",
        "record_units",
        "complete_fields"
      ],
      "properties": {
        "query": {"type": "string", "maxLength": 2048},
        "match": {
          "enum": ["exact", "prefix", "contains"]
        },
        "query_field": {"enum": ["formosan", "translation"]},
        "translation_language": {"type": "string", "maxLength": 35},
        "dialects": {
          "type": "array",
          "items": {"type": "string", "maxLength": 128},
          "maxItems": 1,
          "uniqueItems": true
        },
        "requirements": {
          "type": "array",
          "items": {"enum": ["translation", "audio", "phonology", "interlinear", "unclear"]},
          "maxItems": 5,
          "uniqueItems": true
        },
        "language_ids": {
          "type": "array",
          "items": {"type": "string", "maxLength": 128},
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true
        },
        "corpus_ids": {
          "type": "array",
          "items": {"type": "string", "maxLength": 128},
          "maxItems": 1,
          "uniqueItems": true
        },
        "record_ids": {
          "type": "array",
          "items": {"type": "string", "maxLength": 128},
          "maxItems": 0,
          "uniqueItems": true
        },
        "max_rows": {"type": "integer", "minimum": 1, "maximum": 100000},
        "record_units": {
          "type": "array",
          "items": {"enum": ["sentence", "word", "morpheme"]},
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "complete_fields": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "fields": {
      "type": "object",
      "properties": {
        "sentence": {"$ref": "#/$defs/sentenceFields"},
        "word": {"$ref": "#/$defs/wordFields"},
        "morpheme": {"$ref": "#/$defs/morphemeFields"}
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "format": {
      "enum": ["csv", "tsv", "jsonl"]
    },
    "spreadsheet_safe": {"type": "boolean"}
  },
  "$defs": {
    "sentenceFields": {
      "type": "array",
      "items": {
        "enum": [
          "id", "xml_id", "text_id", "position", "form", "standard", "original",
          "alternate_forms", "translations", "tokens", "token_count", "phonology",
          "source", "unclear", "language_id", "corpus_id", "dialect", "source_path", "audio"
        ]
      },
      "minItems": 1,
      "maxItems": 19,
      "uniqueItems": true
    },
    "wordFields": {
      "type": "array",
      "items": {
        "enum": [
          "id", "xml_id", "parent_id", "sentence_id", "text_id", "position", "form",
          "standard", "original", "alternate_forms", "translations", "phonology", "class",
          "sclass", "unclear", "language_id", "corpus_id", "dialect", "source_path", "audio"
        ]
      },
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true
    },
    "morphemeFields": {
      "type": "array",
      "items": {
        "enum": [
          "id", "xml_id", "parent_id", "word_id", "sentence_id", "text_id", "position",
          "form", "standard", "original", "alternate_forms", "translations", "phonology",
          "class", "sclass", "unclear", "language_id", "corpus_id", "dialect", "source_path",
          "audio"
        ]
      },
      "minItems": 1,
      "maxItems": 21,
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
