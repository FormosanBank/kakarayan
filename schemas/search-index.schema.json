{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formosanbank.github.io/kakarayan/schemas/search-index.schema.json",
  "title": "Kakarayan scoped search vocabulary index",
  "type": "object",
  "required": [
    "schema_version",
    "release_id",
    "language_id",
    "corpus_id",
    "shards",
    "terms"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "release_id": {"type": "string", "pattern": "^fb-[0-9]{8}-[0-9a-f]{7,12}$"},
    "language_id": {"type": "string", "pattern": "^lang_"},
    "corpus_id": {"type": "string", "pattern": "^corpus_"},
    "shards": {"type": "integer", "minimum": 1},
    "terms": {
      "type": "object",
      "required": ["source_exact", "source", "translation", "phonology", "gloss", "regex"],
      "properties": {
        "source_exact": {"$ref": "#/$defs/vocabulary"},
        "source": {"$ref": "#/$defs/vocabulary"},
        "translation": {"$ref": "#/$defs/vocabulary"},
        "phonology": {"$ref": "#/$defs/vocabulary"},
        "gloss": {"$ref": "#/$defs/vocabulary"},
        "regex": {"$ref": "#/$defs/vocabulary"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "vocabulary": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "integer", "minimum": 0},
        "uniqueItems": true
      }
    }
  },
  "additionalProperties": false
}
