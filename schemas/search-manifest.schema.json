{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formosanbank.github.io/kakarayan/schemas/search-manifest.schema.json",
  "title": "Kakarayan search shard manifest",
  "type": "object",
  "required": ["schema_version", "release_id", "record_unit", "shards", "indexes"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "release_id": {"type": "string", "pattern": "^fb-[0-9]{8}-[0-9a-f]{7,12}$"},
    "record_unit": {"const": "sentence"},
    "shards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "language_id",
          "corpus_id",
          "part",
          "records",
          "bytes",
          "uncompressed_bytes",
          "sha256",
          "uncompressed_sha256"
        ],
        "properties": {
          "path": {"type": "string", "pattern": "^search/shards/.+\\.json\\.gz$"},
          "language_id": {"type": "string", "pattern": "^lang_"},
          "corpus_id": {"type": "string", "pattern": "^corpus_"},
          "part": {"type": "integer", "minimum": 0},
          "records": {"type": "integer", "minimum": 1, "maximum": 1000},
          "bytes": {"type": "integer", "minimum": 1},
          "uncompressed_bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "uncompressed_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "indexes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "language_id",
          "corpus_id",
          "shards",
          "terms",
          "bytes",
          "uncompressed_bytes",
          "sha256",
          "uncompressed_sha256"
        ],
        "properties": {
          "path": {"type": "string", "pattern": "^search/indexes/.+/vocabulary\\.json\\.gz$"},
          "language_id": {"type": "string", "pattern": "^lang_"},
          "corpus_id": {"type": "string", "pattern": "^corpus_"},
          "shards": {"type": "integer", "minimum": 1},
          "terms": {"type": "integer", "minimum": 0},
          "bytes": {"type": "integer", "minimum": 1},
          "uncompressed_bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "uncompressed_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
