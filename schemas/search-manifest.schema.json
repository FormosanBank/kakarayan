{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formosanbank.github.io/kakarayan/schemas/search-manifest.schema.json",
  "title": "Kakarayan search shard manifest",
  "type": "object",
  "required": ["schema_version", "release_id", "record_unit", "shards"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "release_id": {"type": "string", "pattern": "^fb-[0-9]{8}-[0-9a-f]{7,12}$"},
    "record_unit": {"const": "sentence"},
    "shards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "language_id", "corpus_id", "records", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^search/shards/"},
          "language_id": {"type": "string", "pattern": "^lang_"},
          "corpus_id": {"type": "string", "pattern": "^corpus_"},
          "records": {"type": "integer", "minimum": 1, "maximum": 1000},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
